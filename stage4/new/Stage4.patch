+	class AmuleResultsParser : public JsonParser
+	{
+	public:
+		AmuleResultsParser(uint64_t ownerId, const string& searchId, const string& searchKind, int resultLimit,
+			std::vector<ExternalSearch::Result>& results, std::unordered_set<string>& seen) :
+			ownerId(ownerId), searchId(searchId), searchKind(searchKind), resultLimit(std::max(1, resultLimit)), results(results), seen(seen),
+			inResults(false), inResult(false), inSources(false), inChildren(false), inChild(false), inProgress(false)
+		{
+		}
+
+		string state;
+
+	protected:
+		bool onValue(string&, int type) noexcept override
+		{
+			const int level = getNestingLevel();
+			if (type == TYPE_OBJECT && inResults && !inChildren && level == 2)
+			{
+				item = Item();
+				inResult = true;
+			}
+			else if (type == TYPE_OBJECT && inResult && inChildren && level == 4)
+			{
+				child = Child();
+				inChild = true;
+			}
+			return true;
+		}
+
+		bool onNamedValue(const string& key, string& value, int type) noexcept override
+		{
+			const int level = getNestingLevel();
+			const string k = Text::toLower(key);
+			if (level == 1)
+			{
+				if (k == "results" && type == TYPE_ARRAY) inResults = true;
+				else if (k == "progress" && type == TYPE_OBJECT) inProgress = true;
+				return true;
+			}
+			if (inResult && !inChild && level == 3)
+			{
+				if (k == "name" && type == TYPE_STRING) item.name = value;
+				else if (k == "hash" && type == TYPE_STRING) item.hash = Text::toLower(value);
+				else if (k == "size" && type == TYPE_INT) item.size = Util::toInt64(value);
+				else if (k == "sources" && type == TYPE_OBJECT) inSources = true;
+				else if (k == "children" && type == TYPE_ARRAY) inChildren = true;
+				return true;
+			}
+			if (inResult && inSources && !inChild && level == 4 && type == TYPE_INT)
+			{
+				if (k == "total") item.sources = Util::toInt(value);
+				else if (k == "complete") item.completeSources = Util::toInt(value);
+				return true;
+			}
+			if (inChild && level == 5)
+			{
+				if (k == "name" && type == TYPE_STRING) child.name = value;
+				else if (k == "ecid" && type == TYPE_INT) child.ecid = value;
+				return true;
+			}
+			if (inProgress && level == 2 && k == "state" && type == TYPE_STRING)
+				state = Text::toLower(value);
+			return true;
+		}
+
+		bool onEndStructure(int type) noexcept override
+		{
+			const int level = getNestingLevel();
+			if (type == TYPE_OBJECT && inChild && level == 5)
+			{
+				if (!child.name.empty() && !child.ecid.empty()) item.children.push_back(child);
+				inChild = false;
+			}
+			else if (type == TYPE_ARRAY && inChildren && level == 4)
+			{
+				inChildren = false;
+			}
+			else if (type == TYPE_OBJECT && inResult && level == 4 && inSources)
+			{
+				inSources = false;
+			}
+			else if (type == TYPE_OBJECT && inResult && level == 3)
+			{
+				emitItem();
+				inResult = false;
+			}
+			else if (type == TYPE_ARRAY && inResults && level == 2)
+			{
+				inResults = false;
+			}
+			else if (type == TYPE_OBJECT && inProgress && level == 2)
+			{
+				inProgress = false;
+			}
+			return true;
+		}
+
+	private:
+		struct Child
+		{
+			string name;
+			string ecid;
+		};
+		struct Item
+		{
+			Item() : size(0), sources(0), completeSources(0) {}
+			string name;
+			string hash;
+			int64_t size;
+			int sources;
+			int completeSources;
+			std::vector<Child> children;
+		};
+
+		void emit(const string& name, const string& backendId) noexcept
+		{
+			if (name.empty() || item.hash.empty() || results.size() >= static_cast<size_t>(resultLimit)) return;
+			const string key = item.hash + "\n" + Util::toString(item.size) + "\n" + (backendId.empty() ? string("parent") : backendId);
+			if (!seen.insert(key).second) return;
+			ExternalSearch::Result r;
+			r.ownerId = ownerId;
+			r.network = ExternalSearch::NETWORK_ED2K;
+			r.networkName = Text::toLower(searchKind) == "kad" ? "Kad" : "eD2k";
+			r.backendName = "aMule";
+			r.name = name;
+			r.path = name;
+			r.size = item.size;
+			r.source = "aMule";
+			r.hashType = "ED2K";
+			r.hash = item.hash;
+			r.searchId = searchId;
+			r.backendId = backendId;
+			r.sourceCount = item.sources;
+			r.completeSourceCount = item.completeSources;
+			results.push_back(r);
+		}
+
+		void emitItem() noexcept
+		{
+			if (item.hash.empty()) return;
+			emit(item.name, Util::emptyString);
+			for (const auto& c : item.children)
+			{
+				if (results.size() >= static_cast<size_t>(resultLimit)) break;
+				emit(c.name, c.ecid);
+			}
+		}
+
+		uint64_t ownerId;
+		string searchId;
+		string searchKind;
+		int resultLimit;
+		std::vector<ExternalSearch::Result>& results;
+		std::unordered_set<string>& seen;
+		Item item;
+		Child child;
+		bool inResults;
+		bool inResult;
+		bool inSources;
+		bool inChildren;
+		bool inChild;
+		bool inProgress;
+	};
