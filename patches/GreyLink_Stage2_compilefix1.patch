+static string sanitizeHubLifecycleField(string value)
+{
+	std::replace(value.begin(), value.end(), '\r', ' ');
+	std::replace(value.begin(), value.end(), '\n', ' ');
+	std::replace(value.begin(), value.end(), '\t', ' ');
+	if (value.size() > 500)
+		value.resize(500);
+	return value;
+}
+
+static void logHubLifecycle(const char* eventName, const string& hubUrl, const string& address,
+	uint16_t port, bool secure, Socket::Protocol proto, const string& detail = Util::emptyString) noexcept
+{
+	try
+	{
+		string message = "[HubLifecycle] tick=" + Util::toString(GET_TICK());
+		message += " event=" + string(eventName);
+		message += " hub=" + sanitizeHubLifecycleField(hubUrl);
+		message += " address=" + sanitizeHubLifecycleField(address);
+		message += " port=" + Util::toString(port);
+		message += " secure=" + string(secure ? "1" : "0");
+		message += " proto=" + Util::toString(static_cast<int>(proto));
+		if (!detail.empty())
+			message += " detail=" + sanitizeHubLifecycleField(detail);
+		LogManager::log(LogManager::SYSTEM, message);
+	}
+	catch (...) {}
+}
