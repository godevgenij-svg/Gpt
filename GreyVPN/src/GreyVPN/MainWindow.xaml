<Window x:Class="GreyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreyVPN" Height="700" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Импорт файлов" Width="120" Margin="0,0,8,0" Click="ImportFiles_Click"/>
            <Button Content="Импорт папки" Width="120" Margin="0,0,8,0" Click="ImportFolder_Click"/>
            <Button Content="Проверить выбранные" Width="155" Margin="0,0,8,0" Click="TestSelected_Click"/>
            <Button Content="Проверить все" Width="120" Margin="0,0,8,0" Click="TestAll_Click"/>
            <Button Content="Стоп" Width="80" Margin="0,0,8,0" Click="Stop_Click"/>
            <Button Content="Удалить выбранные" Width="140" Click="DeleteSelected_Click"/>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="ProfilesGrid"
                  ItemsSource="{Binding Profiles}"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="110"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.5*"/>
                <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="90"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Ping, ms" Binding="{Binding LatencyMs}" Width="80"/>
                <DataGridTextColumn Header="Последняя проверка" Binding="{Binding LastTested, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="145"/>
                <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
