<Window x:Class="GreyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreyVPN v0.8" Height="800" Width="1540" MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel Margin="0,0,0,6">
                <Button Content="Импорт файлов" Width="120" Margin="0,0,8,0" Click="ImportFiles_Click"/>
                <Button Content="Импорт папки" Width="120" Margin="0,0,8,0" Click="ImportFolder_Click"/>
                <Button Content="Предтест выбранных" Width="145" Margin="0,0,8,0" Click="TestSelected_Click"/>
                <Button Content="Предтест всех" Width="120" Margin="0,0,8,0" Click="TestAll_Click"/>
                <Button Content="Реальный тест выбранных" Width="175" Margin="0,0,8,0" Click="RealTestSelectedV05_Click"/>
                <Button Content="Реальный тест кандидатов" Width="190" Margin="0,0,8,0" Click="RealTestResponsiveV05_Click"/>
                <Button Content="Стоп" Width="75" Margin="0,0,8,0" Click="Stop_Click"/>
                <Button Content="Удалить выбранные" Width="140" Click="DeleteSelected_Click"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Только кандидаты" Width="145" Margin="0,0,8,0" Click="ShowResponsive_Click"/>
                <Button Content="Только реально рабочие" Width="165" Margin="0,0,8,0" Click="ShowRealWorking_Click"/>
                <Button Content="Показать все" Width="105" Margin="0,0,8,0" Click="ShowAll_Click"/>
                <Button Content="Экспорт кандидатов" Width="155" Margin="0,0,8,0" Click="ExportResponsive_Click"/>
                <Button Content="Отчёт для ChatGPT" Width="155" Margin="0,0,8,0" FontWeight="SemiBold" Click="CreateChatGptReport_Click"/>
                <TextBlock Margin="18,4,0,0" Foreground="DimGray"
                           Text="REAL v0.8: WireGuard / AmneziaWG = ThroneCore headless без системного TUN; VLESS / VMESS / Trojan = Xray; Hysteria2 / SS / SOCKS / HTTP(S) = sing-box; OpenVPN отдельно."/>
            </WrapPanel>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово"/></StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="ProfilesGrid"
                  ItemsSource="{Binding Profiles}"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="95"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.45*"/>
                <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="75"/>
                <DataGridTextColumn Header="Предтест" Binding="{Binding Status}" Width="105"/>
                <DataGridTextColumn Header="TCP" Binding="{Binding TcpConnectMs}" Width="55"/>
                <DataGridTextColumn Header="ICMP" Binding="{Binding PingMs}" Width="55"/>
                <DataGridTextColumn Header="Реальный" Binding="{Binding RealStatus}" Width="110"/>
                <DataGridTextColumn Header="Exit IP" Binding="{Binding ExitIp}" Width="115"/>
                <DataGridTextColumn Header="Real, ms" Binding="{Binding RealTestMs}" Width="70"/>
                <DataGridTextColumn Header="Последний real" Binding="{Binding LastRealTested, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="105"/>
                <DataGridTextColumn Header="Ошибка real" Binding="{Binding RealError}" Width="2.5*"/>
                <DataGridTextColumn Header="Ошибка предтеста" Binding="{Binding Error}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
