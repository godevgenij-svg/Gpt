<Window x:Class="GreyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreyVPN v0.2" Height="760" Width="1380" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel Margin="0,0,0,6">
                <Button Content="Импорт файлов" Width="120" Margin="0,0,8,0" Click="ImportFiles_Click"/>
                <Button Content="Импорт папки" Width="120" Margin="0,0,8,0" Click="ImportFolder_Click"/>
                <Button Content="Проверить выбранные" Width="155" Margin="0,0,8,0" Click="TestSelected_Click"/>
                <Button Content="Проверить все" Width="120" Margin="0,0,8,0" Click="TestAll_Click"/>
                <Button Content="Стоп" Width="80" Margin="0,0,8,0" Click="Stop_Click"/>
                <Button Content="Удалить выбранные" Width="140" Click="DeleteSelected_Click"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Только откликнувшиеся" Width="165" Margin="0,0,8,0" Click="ShowResponsive_Click"/>
                <Button Content="Показать все" Width="105" Margin="0,0,8,0" Click="ShowAll_Click"/>
                <Button Content="Экспорт откликнувшихся" Width="175" Click="ExportResponsive_Click"/>
                <TextBlock Margin="18,4,0,0" Foreground="DimGray"
                           Text="ENDPOINT OK = TCP endpoint ответил; HOST ONLY = для UDP подтверждён только хост, не VPN handshake."/>
            </WrapPanel>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="ProfilesGrid"
                  ItemsSource="{Binding Profiles}"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="105"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.5*"/>
                <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="85"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115"/>
                <DataGridTextColumn Header="TCP, ms" Binding="{Binding TcpConnectMs}" Width="75"/>
                <DataGridTextColumn Header="ICMP, ms" Binding="{Binding PingMs}" Width="78"/>
                <DataGridTextColumn Header="Попытки" Binding="{Binding TestAttempts}" Width="68"/>
                <DataGridTextColumn Header="Последняя проверка" Binding="{Binding LastTested, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="145"/>
                <DataGridTextColumn Header="Комментарий / ошибка" Binding="{Binding Error}" Width="2.2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
